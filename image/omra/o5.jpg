    <link rel="stylesheet" href="/assets/css/vision-page-voyages.css">



<template id="item-voyage">
    <div class="item-wrap">
        <div class="property-item table-list">
            <div class="voyage-header" id="voyage">

                <div class="image-block">
                    <figure class="item-thumb">
                        <div class="stamp" v-if="voyage.complet == true"><img src="https://admin.visionvoyages.com.tn/file_manager/source/stamp.svg"></div>
                        <div class="price ">
                            <p class="price-start">A partir de</p>
                            <h3 class="price-start">${ parseFloat(voyage.details.prix).formatMoney(3, ',', ' ',true) } ${ voyage.details.devise }                             </h3>

                        </div>
                        <a  v-if="voyage.complet == true" href="#">
                            <img :src="voyage.photo" :alt="voyage.details.libelle" class="photo-voyage">
                        </a>
                        <a  v-else :href="voyage.details.route">
                            <img :src="voyage.photo" :alt="voyage.details.libelle" class="photo-voyage">
                        </a>
                    </figure>
                </div>

                <div class="item-body">

                    <div class="col table-cell">
                        <div class="info-row">


                            <h2 class="property-title">
                                <a  v-if="voyage.complet == true" href="#">${ voyage.details.libelle }</a>
                                <a  v-else :href="voyage.details.route">${ voyage.details.libelle }</a>

                            </h2>

                            <h4 class="property-location" v-if="voyage.details.pays != null && voyage.details.pays != ''">
                                <img src="/assets/images/icons/localisation-search.svg" class="voyage-icon" alt="....">
                                ${ voyage.details.pays}
                            </h4>

                            <h4 class="property-location ">
                                <img src="/assets/images/icons/calendar.svg" class="voyage-icon" alt="....">
                                Durée: ${ voyage.details.nbrJour } jours & ${ voyage.details.nbrNuit } nuits
                            </h4>
                            <h4 class="property-location display-inline">
                                <img src="/assets/images/icons/calendar.svg" class="voyage-icon" alt="....">
                                ${ voyage.depart_retour }</h4>
                            <p>${ voyage.description }</p>

                            <a :href="voyage.details.route" class="btn btn-primary">Plus d'informations
                                <i class="fa fa fa-arrow-right fa-right"></i>
                            </a>
                        </div>

                    </div>
                 


                </div>
                           </div>


        </div>
    </div>
</template>
<script>
    $(document).on('click', '.pagination-main li', function () {
        $('html, body').animate({scrollTop: $('#sidebar').offset().top - $('header').height()}, 700, 'swing');
    })

    let itemVoyage = {
        template: "#item-voyage",
        props: ['response'],
        data: function () {
            return {
                showAllHotels: false,
            }
        },
        computed: {
            voyage: function () {
                var photo = this.response.photoPrincipal;
                // console.log("photo 1===>",photo);
                if (photo && photo.indexOf('/http') > 0)
                    photo = photo.replace('https://admin.visionvoyages.com.tn/', '')
                // console.log("photo 2===>",photo);
                depart_retour = ''
                var description = this.response.descriptionCourte;
                var a_partir_de = this.response.aPartirDe
                var list_hotels = this.response.hotels;
                var photos_pont = this.response.photosPont || [];
                var themes_PF = this.response.themes || [];
                if (photos_pont && photos_pont.indexOf('/http') > 0) photos_pont = photos_pont.replace('https://admin.visionvoyages.com.tn/', '')
                // console.log("photo pont 1===>",photos_pont);
                if (this.response.firstPeriode != null) {
                    var depart = this.response.firstPeriode.depart.split('-')
                    var retour = this.response.firstPeriode.retour.split('-')
                    var departv2 = this.response.firstPeriode.depart
                    var retourv2 = this.response.firstPeriode.retour
                    var complet = this.response.complet
                    console.log(complet)
                    depart_retour = `Du ${depart[2]}/${depart[1]}/${depart[0]} au ${retour[2]}/${retour[1]}/${retour[0]}`
                }

                if (description.length > 150)
                    description = description.slice(0, 120) + '...'
                return {
                    details: this.response,
                    photo: photo,
                    depart_retour: depart_retour,
                    description: description,
                    descriptionCourte: this.response.descriptionCourte,
                    complet: complet,
                    depart: moment(departv2).format("DD MMMM YYYY"),
                    retour: moment(retourv2).format("DD MMMM YYYY"),
                    partir: a_partir_de,
                    hotels: list_hotels,
                    photosPont: photos_pont,
                    themes: themes_PF,

                }

            },

            displayedHotels() {
                if (!this.voyage.hotels) return [];
                return this.showAllHotels
                    ? this.voyage.hotels        // afficher tous
                    : this.voyage.hotels.slice(0, 2); // afficher les 2 premiers
            },


        },
        methods: {
            toggleHotels() {
                this.showAllHotels = !this.showAllHotels;
            },

            updateHotels(list_hotels) {
                this.voyage.hotels = list_hotels || [];
            }
        },
        mounted() {

        },
        updated() {

        },
        destroyed() {

        }
    }

    var vjsListvoyages = new Vue({
        el: "#vjs-list-voyages",
        delimiters: ['${', '}'],
        data: {
            paginate: ['pagin_voyages'],
            voyages: [],
            referentielle: [],
            voyage_loading: 0,
            paginate_per: 10,
        },
        computed: {
            filteredVoyages() {

                return this.voyages
                    .filter(voyage => {
                        /*                         window.history.pushState('data', 'title', vjsRefineResult.routeFiltre());
                        */

                        window.history.pushState('data', 'title', vjsRefineResult.routeFiltre());
                        return (
                            (vjsRefineResult.filtre_destinations.length == 0 || $.inArray(voyage.destination, vjsRefineResult.filtre_destinations) != -1) &&
                            (vjsRefineResult.filtre_themes.length == 0 || (Object.values(voyage._themes).filter(x => vjsRefineResult.filtre_themes.includes(x))).length > 0) &&
                            (vjsRefineResult.filtre_pays.length == 0 || $.inArray(voyage.pays, vjsRefineResult.filtre_pays) != -1)

                        )
                    })
                    .sort((a, b) => {

                            let trie = vjsSortResult.trie.split('-')[0];
                            let direction = (vjsSortResult.trie.split('-')[1] == 'asc' ? 1 : -1);

                            var a1 = a[trie], b1 = b[trie];
                            if (a1 == b1) return 0;
                            return a1 > b1 ? 1 * direction : -1 * direction;
                        }
                    );
            },

        },
                watch: {
            filteredVoyages(newVal, oldVal) {
                if (newVal.length !== 0 && oldVal.length === 0) {
                    setTimeout(() => {
                        if (this.$refs.paginator) {
                            this.$refs.paginator.goToPage(1)
                        }
                    }, 50)
                }
            }
        },
                methods: {},
        mounted() {
            this.voyage_loading = 5

            if (typeof vjsRefineResult !== 'undefined')
                vjsRefineResult.visible = true

            if (typeof vjsSortResult !== 'undefined') {
                vjsSortResult.voyage_loading = 5
                vjsSortResult.visible = true
            }

            if (typeof vjsRecapSearch !== 'undefined') {
                vjsRecapSearch.voyage_loading = 5
                vjsRecapSearch.visible = true
            }

            axios
                .get('/voyages-organises/json-voyages/7',
                    {
                        params: {
                            type: 7,
                            themes: 'all',
                            destinations: 'all',
                            pays: 'all'
                        }
                    })
                .then(response => {
                    if (response.data.Erreur !== undefined)
                        viewAlert(response.data.Erreur, 'danger')
                    else if (response.data.Error !== undefined) {
                        viewAlert('Erreur', 'danger')
                        console.error(response.data.Error)
                    } else {
                        vjsListvoyages.referentielle = response.data.referentielle;

                        if (typeof vjsRefineResult !== 'undefined') {
                            vjsRefineResult.filtre_destinations.length = 0
                            vjsRefineResult.filtre_themes.length = 0
                            vjsRefineResult.filtre_pays.length = 0
                            vjsRefineResult.voyage_loading = 0
                            //****************************************************************************
                            var themes = 'all'
                            var destinations = 'all'
                            var pays = 'all'

                            if (themes != 'all' && vjsListvoyages.referentielle.themes !== undefined) {
                                let _themes = flip(vjsListvoyages.referentielle.themes)
                                for (let valeur of themes.split(','))
                                    vjsRefineResult.filtre_themes.push(_themes[valeur])
                            }

                            if (destinations != 'all' && vjsListvoyages.referentielle.destinations !== undefined) {
                                let _destinations = flip(vjsListvoyages.referentielle.destinations)
                                for (let valeur of destinations.split(','))
                                    vjsRefineResult.filtre_destinations.push(_destinations[valeur])
                            }

                            if (pays != 'all' && vjsListvoyages.referentielle.pays !== undefined)
                                for (let valeur of pays.split(','))
                                    vjsRefineResult.filtre_pays.push(Object.values(vjsListvoyages.referentielle.pays).filter(p => p.id == valeur)[0].libelle)
                            //****************************************************************************
                            vjsRefineResult.visible = false
                        }

                        if (typeof vjsSortResult !== 'undefined') {
                            vjsSortResult.voyage_loading = 0
                            vjsSortResult.visible = false
                        }

                        if (typeof vjsRecapSearch !== 'undefined') {
                            vjsRecapSearch.voyage_loading = 0
                            vjsRecapSearch.visible = false
                        }

                        this.voyage_loading = 0

                        if (response.data.Voyage !== undefined) {
                            var voyages = response.data.Voyage

                            var filtres = response.data.filtre

                            vjsListvoyages.voyages = voyages;
                            vjsListvoyages.voyages = voyages;

                            if (typeof vjsSortResult !== 'undefined') {
                                vjsSortResult.nbr_voyages = voyages.length
                                vjsSortResult.visible = (voyages.length > 0)
                            }

                            if (typeof vjsRecapSearch !== 'undefined') {
                                vjsRecapSearch.nbr_voyages = voyages.length
                                vjsRecapSearch.visible = (voyages.length > 0)
                            }

                            if (typeof vjsRefineResult !== 'undefined') {
                                vjsRefineResult.visible = (voyages.length > 0)
                                vjsRefineResult.liste_destinations = filtres.destinations;
                                vjsRefineResult.liste_themes = filtres.themes;
                                vjsRefineResult.liste_themesCategorie = filtres.themesCategorie;
                                vjsRefineResult.liste_pays = filtres.pays;
                            }

                            if (vjsRefineResult.liste_destinations.length == 0 && vjsRefineResult.liste_themes.length == 0 && vjsRefineResult.liste_pays.length == 0) {
                                $('#sidebar-filtre').remove()
                                $('#contenu-liste').removeClass('col-lg-9 col-md-9')
                            }
                        }
                    }


                });
        },
        updated() {
            checkEllipsisActive('#vjs-list-voyages') // Call function text-corpe
                    },
        components: {itemVoyage}
    })




</script>

</body>
